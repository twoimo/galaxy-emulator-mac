#!/usr/bin/env node

const { execSync, spawn, spawnSync } = require('child_process');
const fs = require('fs');
const path = require('path');

const ROOT_DIR = path.resolve(__dirname, '..');
const UI_CACHE_FILE = '/tmp/galaxy-emu-ui.json';
const SOM_BIN = path.join(ROOT_DIR, 'bin', 'som-drawer');

const extraPaths = [
  '/opt/homebrew/bin',
  '/Applications/Tailscale.app/Contents/MacOS',
  path.join(process.env.HOME, 'Library/Android/sdk/platform-tools'),
  path.join(process.env.HOME, 'Library/Android/sdk/emulator'),
  path.join(process.env.HOME, 'Library/Android/sdk/cmdline-tools/latest/bin'),
];
process.env.PATH = `${extraPaths.join(':')}:${process.env.PATH}`;

const rawArgs = process.argv.slice(2);

let targetSerial = null;
const filteredArgs = [];
for (let i = 0; i < rawArgs.length; i++) {
  if (rawArgs[i] === '-s' && rawArgs[i + 1]) {
    targetSerial = rawArgs[i + 1];
    i++;
  } else {
    filteredArgs.push(rawArgs[i]);
  }
}

const command = filteredArgs[0] || 'help';

function getConnectedDevices() {
  try {
    const out = execSync('adb devices -l', { encoding: 'utf8' });
    const lines = out.trim().split('\n').slice(1);
    const devices = [];
    for (const line of lines) {
      const parts = line.trim().split(/\s+/);
      if (parts.length >= 2 && parts[1] === 'device') {
        const serial = parts[0];
        const isEmulator = serial.startsWith('emulator-');
        let model = 'Unknown';
        for (const p of parts) {
          if (p.startsWith('model:')) model = p.split(':')[1];
        }
        devices.push({ serial, type: isEmulator ? 'emulator' : 'physical', model });
      }
    }
    return devices;
  } catch {
    return [];
  }
}

function resolveSerial(explicitSerial) {
  if (explicitSerial) return explicitSerial;
  const list = getConnectedDevices();
  if (list.length === 0) {
    console.error('❌ Error: No Android device or emulator is currently connected via ADB.');
    console.error('👉 Run `galaxy-emu connect` for physical phone or `galaxy-emu boot s24u` for AVD.');
    process.exit(1);
  }
  const emu = list.find(d => d.type === 'emulator');
  if (emu) return emu.serial;
  return list[0].serial;
}

function adbExec(serial, cmd) {
  const serialFlag = serial ? `-s ${serial}` : '';
  return execSync(`adb ${serialFlag} ${cmd}`, { encoding: 'utf8' });
}

function fetchUiHierarchy(serial) {
  const tempPath = '/data/local/tmp/uidump.xml';
  adbExec(serial, `shell uiautomator dump ${tempPath}`);
  const xml = adbExec(serial, `shell cat ${tempPath}`);
  
  const nodeTagRegex = /<node\s+([^>]+)>/g;
  const elements = [];
  let m;
  let index = 1;
  while ((m = nodeTagRegex.exec(xml)) !== null) {
    const attrs = m[1];
    const getText = (name) => {
      const match = attrs.match(new RegExp(name + '="([^"]*)"'));
      return match ? match[1] : '';
    };
    const text = getText('text');
    const desc = getText('content-desc');
    const id = getText('resource-id');
    const clickable = getText('clickable') === 'true';
    const bounds = getText('bounds');
    const boundsMatch = bounds.match(/\[(\d+),(\d+)\]\[(\d+),(\d+)\]/);

    if ((text || desc || (id && clickable)) && boundsMatch) {
      const [, x1, y1, x2, y2] = boundsMatch;
      const cx = Math.round((parseInt(x1, 10) + parseInt(x2, 10)) / 2);
      const cy = Math.round((parseInt(y1, 10) + parseInt(y2, 10)) / 2);
      elements.push({
        index: index++,
        text: text || null,
        desc: desc || null,
        id: id || null,
        clickable,
        bounds,
        center: [cx, cy],
      });
    }
  }

  try {
    fs.writeFileSync(UI_CACHE_FILE, JSON.stringify({ serial, timestamp: Date.now(), elements }), 'utf8');
  } catch {}

  return elements;
}

function printHelp() {
  console.log(`
🌌 Galaxy Unified Control CLI (Full AI Agent-First Suite)
==========================================================
Usage: galaxy-emu <command> [options] [-s <serial>]

Target & Connectivity:
  devices [--json]                List connected physical phones and running emulators
  connect [ip:port]               Auto-detect and connect physical Galaxy via Tailscale
  disconnect [serial]             Disconnect wireless ADB transport
  mirror [-s serial]              Launch 60fps scrcpy mirroring window (screen-off mode)

Advanced Observation (Vision & SoM):
  som [output.png]                Generate Set-of-Marks visual numbered overlay screenshot
  uidump [--json]                 Dump clickable UI with labeled indexes [1], [2], [3]...
  screenshot [output.png]         Capture full-resolution screenshot to file
  current                         Get active focused foreground package & activity
  notifications [--json]          Extract latest incoming notifications/SMS auth codes

Smart Actions (Zero Coordinate Guessing):
  tap <index | "label" | x y>     Smart tap by index ([3]), text ("YouTube"), or coordinate
  find "<text>" [--tap]           Scroll-until-found: auto-scroll until target element appears
  clear                           Clear text in currently focused input field completely
  type "<text>"                   Full Unicode/Korean typing (auto-routes via clipboard)
  swipe <x1> <y1> <x2> <y2> [ms]  Swipe/scroll between coordinates
  key <NAME>                      Send keyevent: HOME, BACK, POWER, ENTER, APP_SWITCH, VOL_UP

App & VM Management:
  app start <package/act | URL>   Launch app component or open URL in browser
  app stop <package>              Force-stop target package
  boot [profile] [--headless]     Boot local ARM64 AVD and wait for readiness
  stop [serial|all]               Gracefully shut down emulator instance
`);
}

switch (command) {
  case 'devices': {
    const list = getConnectedDevices();
    if (filteredArgs.includes('--json')) {
      console.log(JSON.stringify(list, null, 2));
    } else {
      console.log('\n📱 Connected Android Devices & Emulators:');
      for (const d of list) {
        console.log(`  - [${d.type.toUpperCase()}] ${d.model} (${d.serial})`);
      }
    }
    break;
  }

  case 'connect': {
    let targetEndpoint = filteredArgs[1];
    if (!targetEndpoint) {
      console.log('🔍 Looking for active Android devices in Tailnet...');
      try {
        const tsOut = execSync('tailscale status 2>/dev/null', { encoding: 'utf8' });
        for (const line of tsOut.split('\n')) {
          if (line.includes('android') && (line.includes('active') || line.includes('idle'))) {
            const ip = line.trim().split(/\s+/)[0];
            if (ip) {
              const devList = getConnectedDevices();
              const existing = devList.find(d => d.serial.startsWith(ip));
              if (existing) {
                console.log(`✅ Physical device is already connected via ADB: ${existing.serial}`);
                process.exit(0);
              }
              targetEndpoint = `${ip}:5555`;
              console.log(`📍 Found Tailscale Galaxy: ${ip} -> Trying port 5555...`);
              break;
            }
          }
        }
      } catch {}
    }

    if (!targetEndpoint) {
      console.error('❌ Could not auto-detect active Tailscale Android device.');
      console.error('👉 Usage: galaxy-emu connect <ip:port>');
      process.exit(1);
    }

    console.log(`🔌 Connecting to ${targetEndpoint}...`);
    try {
      const res = execSync(`adb connect ${targetEndpoint}`, { encoding: 'utf8' }).trim();
      console.log(res);
    } catch (e) {
      console.error('❌ Failed to connect:', e.message);
      process.exit(1);
    }
    break;
  }

  case 'disconnect': {
    const serial = targetSerial || filteredArgs[1];
    if (!serial) {
      execSync('adb disconnect');
      console.log('🔌 Disconnected all wireless ADB connections.');
    } else {
      execSync(`adb disconnect ${serial}`);
      console.log(`🔌 Disconnected ${serial}.`);
    }
    break;
  }

  case 'screenshot': {
    const serial = resolveSerial(targetSerial);
    const outPath = filteredArgs[1] || path.join(process.cwd(), `screenshot-${serial.replace(/[:.]/g, '_')}.png`);
    execSync(`adb -s "${serial}" exec-out screencap -p > "${outPath}"`);
    console.log(`✅ Screenshot saved from ${serial} -> ${outPath} (${fs.statSync(outPath).size} bytes)`);
    break;
  }

  case 'som': {
    const serial = resolveSerial(targetSerial);
    const outPath = filteredArgs[1] || path.join(process.cwd(), `som-${serial.replace(/[:.]/g, '_')}.png`);
    const rawPng = `/tmp/som-raw-${serial.replace(/[:.]/g, '_')}.png`;
    const jsonPath = `/tmp/som-elements-${serial.replace(/[:.]/g, '_')}.json`;

    console.log(`🎨 Generating Set-of-Marks (SoM) labeled overlay for ${serial}...`);
    execSync(`adb -s "${serial}" exec-out screencap -p > "${rawPng}"`);
    const elements = fetchUiHierarchy(serial);
    fs.writeFileSync(jsonPath, JSON.stringify({ serial, elements }), 'utf8');

    try {
      execSync(`"${SOM_BIN}" "${rawPng}" "${jsonPath}" "${outPath}"`, { stdio: 'inherit' });
      console.log(`🖼️ Set-of-Marks image ready: ${outPath}`);
    } catch (e) {
      console.error('❌ Failed to draw SoM overlay:', e.message);
      process.exit(1);
    }
    break;
  }

  case 'uidump': {
    const serial = resolveSerial(targetSerial);
    try {
      const elements = fetchUiHierarchy(serial);
      if (filteredArgs.includes('--json')) {
        console.log(JSON.stringify({ serial, count: elements.length, elements }, null, 2));
      } else {
        console.log(`\n🔍 Labeled Interactive UI Elements on ${serial} (${elements.length} found):`);
        for (const el of elements.slice(0, 35)) {
          const label = el.text ? `"${el.text}"` : (el.desc ? `[${el.desc}]` : el.id);
          console.log(`  [${el.index}] ${label.padEnd(35)} Tap Center: (${el.center[0]}, ${el.center[1]})`);
        }
      }
    } catch (e) {
      console.error('❌ Failed to dump UI hierarchy:', e.message);
      process.exit(1);
    }
    break;
  }

  case 'find': {
    const serial = resolveSerial(targetSerial);
    const query = (filteredArgs[1] || '').toLowerCase();
    const shouldTap = filteredArgs.includes('--tap');
    if (!query) {
      console.error('❌ Usage: galaxy-emu find "<text_or_desc>" [--tap] [-s serial]');
      process.exit(1);
    }

    console.log(`🔍 Searching screen for "${query}" (auto-scroll enabled)...`);
    let found = null;
    const maxScrolls = 6;

    for (let scroll = 0; scroll <= maxScrolls; scroll++) {
      const elements = fetchUiHierarchy(serial);
      found = elements.find(el =>
        (el.text && el.text.toLowerCase().includes(query)) ||
        (el.desc && el.desc.toLowerCase().includes(query)) ||
        (el.id && el.id.toLowerCase().includes(query))
      );

      if (found) {
        console.log(`🎯 Found matching element: [${found.index}] "${found.text || found.desc}" at Center: (${found.center[0]}, ${found.center[1]})`);
        if (shouldTap) {
          adbExec(serial, `shell input tap ${found.center[0]} ${found.center[1]}`);
          console.log(`👆 Automatically tapped (${found.center[0]}, ${found.center[1]})`);
        }
        process.exit(0);
      }

      if (scroll < maxScrolls) {
        console.log(`📜 Element not visible on current screen. Scrolling down (${scroll + 1}/${maxScrolls})...`);
        adbExec(serial, 'shell input swipe 720 2200 720 800 350');
        spawnSync('sleep', ['1.2']);
      }
    }

    console.error(`❌ Element matching "${query}" was not found after ${maxScrolls} scrolls.`);
    process.exit(1);
    break;
  }

  case 'clear': {
    const serial = resolveSerial(targetSerial);
    console.log(`🧹 Clearing focused text input on ${serial}...`);
    // Move to end and delete 50 times
    adbExec(serial, 'shell input keyevent 123'); // KEYCODE_MOVE_END
    const delKeys = Array(45).fill('67').join(' '); // KEYCODE_DEL
    adbExec(serial, `shell input keyevent ${delKeys}`);
    console.log('✅ Input cleared.');
    break;
  }

  case 'notifications': {
    const serial = resolveSerial(targetSerial);
    try {
      const dump = adbExec(serial, 'shell dumpsys notification --noredact 2>/dev/null || adb shell dumpsys notification');
      const lines = dump.split('\n');
      const notifs = [];
      let current = null;

      for (const line of lines) {
        const pkgMatch = line.match(/pkg=([^\s]+)/);
        if (pkgMatch) {
          if (current && (current.title || current.text)) notifs.push(current);
          current = { pkg: pkgMatch[1], title: '', text: '' };
        }
        if (current) {
          const tMatch = line.match(/android\.title=String \((.*?)\)/);
          if (tMatch) current.title = tMatch[1];
          const txtMatch = line.match(/android\.text=String \((.*?)\)/);
          if (txtMatch) current.text = txtMatch[1];
        }
      }
      if (current && (current.title || current.text)) notifs.push(current);

      if (filteredArgs.includes('--json')) {
        console.log(JSON.stringify(notifs.slice(0, 15), null, 2));
      } else {
        console.log(`\n🔔 Active Notifications on ${serial} (${notifs.length} found):`);
        for (const n of notifs.slice(0, 10)) {
          console.log(`  - [${n.pkg}] ${n.title ? n.title + ': ' : ''}${n.text}`);
        }
      }
    } catch (e) {
      console.error('❌ Failed to fetch notifications:', e.message);
      process.exit(1);
    }
    break;
  }

  case 'tap': {
    const serial = resolveSerial(targetSerial);
    const arg1 = filteredArgs[1];
    const arg2 = filteredArgs[2];

    if (!arg1) {
      console.error('❌ Usage: galaxy-emu tap <index | "label" | x y> [-s serial]');
      process.exit(1);
    }

    if (arg1 && arg2 && !isNaN(parseInt(arg1, 10)) && !isNaN(parseInt(arg2, 10))) {
      adbExec(serial, `shell input tap ${arg1} ${arg2}`);
      console.log(`👆 Tapped coordinates (${arg1}, ${arg2}) on ${serial}`);
      break;
    }

    let elements = [];
    try {
      if (fs.existsSync(UI_CACHE_FILE)) {
        const cached = JSON.parse(fs.readFileSync(UI_CACHE_FILE, 'utf8'));
        if (cached.serial === serial && Date.now() - cached.timestamp < 15000) {
          elements = cached.elements;
        }
      }
    } catch {}

    if (elements.length === 0) elements = fetchUiHierarchy(serial);

    const targetIdx = parseInt(arg1, 10);
    if (!isNaN(targetIdx)) {
      const match = elements.find(el => el.index === targetIdx);
      if (!match) {
        console.error(`❌ Index [${targetIdx}] not found. Run \`galaxy-emu uidump\` to view current elements.`);
        process.exit(1);
      }
      const [cx, cy] = match.center;
      adbExec(serial, `shell input tap ${cx} ${cy}`);
      const label = match.text || match.desc || match.id || `Index ${targetIdx}`;
      console.log(`👆 Smart Tapped [${targetIdx}] ${label} at (${cx}, ${cy}) on ${serial}`);
      break;
    }

    const query = arg1.toLowerCase();
    const match = elements.find(el => 
      (el.text && el.text.toLowerCase().includes(query)) ||
      (el.desc && el.desc.toLowerCase().includes(query)) ||
      (el.id && el.id.toLowerCase().includes(query))
    );

    if (!match) {
      console.error(`❌ Element matching "${arg1}" not found. Run \`galaxy-emu uidump\` to refresh items.`);
      process.exit(1);
    }

    const [cx, cy] = match.center;
    adbExec(serial, `shell input tap ${cx} ${cy}`);
    const foundLabel = match.text || match.desc || match.id;
    console.log(`👆 Smart Tapped "${foundLabel}" at (${cx}, ${cy}) on ${serial}`);
    break;
  }

  case 'swipe': {
    const serial = resolveSerial(targetSerial);
    const [, x1, y1, x2, y2, dur = '300'] = filteredArgs;
    if (!x1 || !y1 || !x2 || !y2) {
      console.error('❌ Usage: galaxy-emu swipe <x1> <y1> <x2> <y2> [duration_ms] [-s serial]');
      process.exit(1);
    }
    adbExec(serial, `shell input swipe ${x1} ${y1} ${x2} ${y2} ${dur}`);
    console.log(`👉 Swiped from (${x1}, ${y1}) to (${x2}, ${y2}) on ${serial}`);
    break;
  }

  case 'type': {
    const serial = resolveSerial(targetSerial);
    const text = filteredArgs[1];
    if (text === undefined) {
      console.error('❌ Usage: galaxy-emu type "<text>" [-s serial]');
      process.exit(1);
    }

    const hasUnicode = /[^\x00-\x7F]/.test(text);
    if (hasUnicode) {
      try {
        execSync(`echo -n "${text.replace(/"/g, '\\"')}" | pbcopy`);
        adbExec(serial, 'shell input keyevent 279');
        console.log(`⌨️ [Unicode/Korean] Typed "${text}" via clipboard paste on ${serial}`);
      } catch (e) {
        const encoded = text.replace(/[ %()<>|&;*\\"`$#~]/g, (c) => (c === ' ' ? '%s' : `\\${c}`));
        adbExec(serial, `shell input text "${encoded}"`);
      }
    } else {
      const encoded = text.replace(/[ %()<>|&;*\\"`$#~]/g, (c) => (c === ' ' ? '%s' : `\\${c}`));
      adbExec(serial, `shell input text "${encoded}"`);
      console.log(`⌨️ [ASCII] Typed "${text}" on ${serial}`);
    }
    break;
  }

  case 'key': {
    const serial = resolveSerial(targetSerial);
    const keyName = (filteredArgs[1] || '').toUpperCase();
    const KEY_MAP = {
      HOME: 3,
      BACK: 4,
      POWER: 26,
      ENTER: 66,
      APP_SWITCH: 187,
      VOL_UP: 24,
      VOL_DOWN: 25,
      TAB: 61,
      ESCAPE: 111,
      SPACE: 62,
      PASTE: 279,
    };
    const code = KEY_MAP[keyName] || parseInt(keyName, 10);
    if (!code) {
      console.error(`❌ Unknown key: ${keyName}. Supported: ${Object.keys(KEY_MAP).join(', ')}`);
      process.exit(1);
    }
    adbExec(serial, `shell input keyevent ${code}`);
    console.log(`⚡ Key ${keyName} (${code}) sent to ${serial}`);
    break;
  }

  case 'current': {
    const serial = resolveSerial(targetSerial);
    const focus = adbExec(serial, "shell dumpsys window | grep -E 'mCurrentFocus|mFocusedApp'").trim();
    console.log(`📍 Current Foreground on ${serial}:\n${focus}`);
    break;
  }

  case 'app': {
    const [, sub, target] = filteredArgs;
    const serial = resolveSerial(targetSerial);
    if (sub === 'start') {
      if (!target) {
        console.error('❌ Usage: galaxy-emu app start <pkg/act | URL> [-s serial]');
        process.exit(1);
      }
      if (target.startsWith('http://') || target.startsWith('https://')) {
        adbExec(serial, `shell am start -a android.intent.action.VIEW -d "${target}"`);
        console.log(`🌐 Opened URL ${target} on ${serial}`);
      } else {
        adbExec(serial, `shell am start -n "${target}"`);
        console.log(`🚀 Started component ${target} on ${serial}`);
      }
    } else if (sub === 'stop') {
      if (!target) {
        console.error('❌ Usage: galaxy-emu app stop <package> [-s serial]');
        process.exit(1);
      }
      adbExec(serial, `shell am force-stop "${target}"`);
      console.log(`🛑 Force-stopped ${target} on ${serial}`);
    }
    break;
  }

  case 'boot': {
    const profile = filteredArgs[1] || 's24u';
    const headless = filteredArgs.includes('--headless');
    const avdName = profile === 'flip5' ? 'Galaxy_Z_Flip5' : 'Galaxy_S24_Ultra';

    console.log(`🚀 Booting ${avdName} (headless: ${headless})...`);
    const flags = ['-avd', avdName, '-gpu', 'host'];
    if (headless) flags.push('-no-window');

    const proc = spawn('emulator', flags, { detached: true, stdio: 'ignore' });
    proc.unref();

    console.log('⏳ Waiting for emulator to appear on ADB...');
    let onlineSerial = null;
    for (let i = 0; i < 20; i++) {
      const list = getConnectedDevices().filter(d => d.type === 'emulator');
      if (list.length > 0) {
        onlineSerial = list[0].serial;
        break;
      }
      spawnSync('sleep', ['2']);
    }

    if (!onlineSerial) {
      console.error('❌ Timeout waiting for emulator to connect to ADB.');
      process.exit(1);
    }

    console.log(`📲 Detected ${onlineSerial}. Waiting for Android OS boot_completed...`);
    for (let i = 0; i < 30; i++) {
      try {
        const booted = execSync(`adb -s ${onlineSerial} shell getprop sys.boot_completed`, { encoding: 'utf8' }).trim();
        if (booted === '1') {
          console.log(`🎉 Emulator ${onlineSerial} is fully booted and ready for commands!`);
          process.exit(0);
        }
      } catch {}
      spawnSync('sleep', ['2']);
    }
    console.warn('⚠️ Emulator is online, but sys.boot_completed took longer than expected.');
    break;
  }

  case 'stop': {
    const serial = resolveSerial(targetSerial);
    if (serial.startsWith('emulator-')) {
      console.log(`🛑 Shutting down emulator ${serial}...`);
      adbExec(serial, 'emu kill');
      console.log('✅ Emulator stopped.');
    } else {
      console.log(`ℹ️ Target ${serial} is a physical device. Disconnecting ADB...`);
      execSync(`adb disconnect ${serial}`);
      console.log('✅ Disconnected.');
    }
    break;
  }

  case 'mirror': {
    const serial = resolveSerial(targetSerial);
    console.log(`🖥️ Launching scrcpy for ${serial} (screen-off mode)...`);
    spawn('scrcpy', [
      '-s', serial,
      '--turn-screen-off',
      '--stay-awake',
      '--window-title', `Galaxy (${serial})`,
      '--always-on-top',
    ], { detached: true, stdio: 'ignore' }).unref();
    console.log('✅ scrcpy running in background on macOS desktop.');
    break;
  }

  case 'help':
  default:
    printHelp();
    break;
}
